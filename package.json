{
  "name": "orbrun-monorepo",
  "private": true,
  "description": "Orbrun: a 2.5D Dungeon Crawl Stone Soup WebTiles client for keyboard, controllers and touch.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caeous/orbrun.git"
  },
  "homepage": "https://orbrun.app",
  "bugs": "https://github.com/Caeous/orbrun/issues",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/orbrun",
    "prebuild": "node tools/build/ensure-dev-deps.mjs",
    "build": "npm run build -w apps/orbrun",
    "preview": "npm run preview -w apps/orbrun",
    "typecheck": "tsc -b && tsc -p tsconfig.browser.json",
    "test": "vitest run --project unit",
    "e2e": "vitest run -c vitest.e2e.config.ts",
    "record": "node tools/record/record.mjs",
    "room:pack": "node tools/build/pack-room.mjs",
    "room:poster": "node tools/build/poster.mjs",
    "deploy": "wrangler deploy",
    "deploy:guard": "node tools/build/deploy-guard.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "verify": "npm run typecheck && npm test",
    "verify:browser": "playwright test",
    "typecheck:full": "tsc -b tsconfig.json tsconfig.browser.json --force",
    "test:changed": "vitest run --changed HEAD --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:deploy": "vitest run --project deploy",
    "verify:render": "BROWSER_SUITE=full playwright test",
    "verify:production": "npm run build && BROWSER_SUITE=production playwright test",
    "verify:release": "npm run typecheck:full && vitest run && npm run build && BROWSER_SUITE=release playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.4.1",
    "happy-dom": "^20.14.0",
    "opentype.js": "^2.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0",
    "ws": "^8.18.0"
  }
}
