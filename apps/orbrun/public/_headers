# vite names every bundle by its content hash (dist/assets), so a path never changes meaning
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the self-hosted faces are named by fixed paths (styles.css @font-face) and change only with a deploy that
# renames them, so a return visit never asks for them again
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Pages use inline styles, but every executable script is a same-origin asset.
# Server-provided HTML must not execute inline handlers/scripts or embed frames.
/*
  Content-Security-Policy: script-src 'self'; script-src-attr 'none'; object-src 'none'; base-uri 'self'; frame-src 'none'; frame-ancestors 'none'; worker-src 'self' blob:
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
