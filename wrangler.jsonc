{
  // DCSS Client: a Worker that serves the static build and the gamedata proxy.
  //
  // Cloudflare's build settings must have Root directory = / (the monorepo
  // root), because apps/orbrun depends on the workspace packages by name and
  // on the root's vite: an `npm ci` inside apps/orbrun resolves neither.
  //   Build variable: SKIP_DEPENDENCY_INSTALL=1
  //   Build command:  npm ci --include=dev --prefer-offline --no-audit --no-fund && npm run typecheck && NODE_ENV=test npm test
  //   Deploy command: npm run deploy
  // Disable Cloudflare's automatic install so dependencies are installed once.
  // The deploy hook below runs the single asset build, with Git checks before
  // and after it. Do not add `npm run build` to the Cloudflare build command.
  //
  // The `--include=dev` is required. The build image exports
  // NPM_CONFIG_INCLUDE=prod and NPM_CONFIG_OMIT=dev, which outrank this repo's
  // .npmrc, so a plain `npm ci` installs 8 packages and no vite. A CLI flag
  // outranks the environment; setting NPM_CONFIG_INCLUDE=dev as a build
  // variable in the dashboard works too. Note `npm ci`, not `npm install`: on the
  // image's npm 10.9.2 a plain `npm install --include=dev` reports "up to date" and
  // leaves the pruned tree alone. As a backstop the root `prebuild` script
  // (tools/build/ensure-dev-deps.mjs) reinstalls when vite is missing.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcss-client",
  "main": "apps/orbrun/worker/index.ts",
  "compatibility_date": "2025-04-01",
  // Guard direct CLI deployments as well as npm run deploy; always rebuild the assets.
  "build": {
    "command": "node tools/build/deploy-build.mjs",
    "watch_dir": ["apps/orbrun/src", "packages"]
  },
  "assets": {
    "directory": "apps/orbrun/dist",
    "binding": "ASSETS",
    // the app routes on the path (servers.ts `parseRoute`), so any path that
    // is not an asset is still the app shell
    "not_found_handling": "single-page-application",
    // without this the asset layer answers the proxy routes with index.html
    // and the gamedata loader is handed HTML instead of JavaScript. The rest
    // comes through the Worker too, so an address that is none of the app's
    // says 404 (worker/index.ts answerPage); only the files that are never a
    // page skip it
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/room/*", "!/steam/*", "!/icons/*"]
  },
  // This fork deploys online play only. No engine Worker or analytics dataset is needed.
  "observability": {
    "enabled": true
  }
}
