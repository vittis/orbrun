Include actual beam damage in hit messages for the client's combat popups.
Adapted from Super Dungeon Crawl's spell-damage-numbers.patch:
https://github.com/vimuston/super-dungeon-crawl
GPLv2+, as the DCSS file it patches.

--- a/crawl-ref/source/beam.cc
+++ b/crawl-ref/source/beam.cc
@@ -4380,13 +4380,20 @@
     if (!is_enchantment()
         && !(damage.num == 0 && is_big_cloud()))
     {
+#ifdef __EMSCRIPTEN__
+        mprf("The %s %s %s%s%s%s%s", name.c_str(), hit_verb.c_str(),
+#else
         mprf("The %s %s %s%s%s%s", name.c_str(), hit_verb.c_str(),
+#endif
              you.hp > 0 ? "you" : "your lifeless body",
              real_flavour != BEAM_CHAOS ? ""
                     : make_stringf(" with %s", _beam_type_name(flavour).c_str()).c_str(),
              damage.num > 0 && final_dam == 0 ? plural ? " but do no damage"
                                                        : " but does no damage"
                                               : "",
+#ifdef __EMSCRIPTEN__
+             final_dam > 0 ? make_stringf(" for %d", final_dam).c_str() : "",
+#endif
              attack_strength_punctuation(final_dam).c_str());
     }
 
@@ -5762,7 +5769,11 @@
         // no need to also say "does no damage" here.
         if (damage.num > 0 || !is_big_cloud())
         {
+#ifdef __EMSCRIPTEN__
+            mprf("The %s %s %s%s%s%s%s",
+#else
             mprf("The %s %s %s%s%s%s",
+#endif
                 name.c_str(),
                 hit_verb.c_str(),
                 mon->name(DESC_THE).c_str(),
@@ -5771,6 +5782,9 @@
                 damage.num > 0 && postac == 0 ? plural ? " but do no damage"
                                                         : " but does no damage"
                                                : "",
+#ifdef __EMSCRIPTEN__
+                final > 0 ? make_stringf(" for %d", final).c_str() : "",
+#endif
                 attack_strength_punctuation(final).c_str());
         }
 
