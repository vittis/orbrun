# A bounded, disposable encounter. All movement, visibility and combat are Crawl's.
# Random alternatives and the game seed vary the live encounter on each restart.
NAME:   orbrun_menu
TAGS:   sprint no_item_gen no_trap_gen no_pool_fixup no_rotate no_hmirror no_vmirror
DESC:   Orbrun menu encounter
ORIENT: encompass
KFEAT:  abc = .
MARKER: a = lua:props_marker { menu_spawn = "small" }
MARKER: b = lua:props_marker { menu_spawn = "humanoid" }
MARKER: c = lua:props_marker { menu_spawn = "beast" }
# Startup clears hostile monsters in LOS before running map epilogues.
epilogue{{
  if crawl.game_started() then
    local groups = {
      small = {"rat", "quokka", "bat"},
      humanoid = {"goblin", "hobgoblin", "kobold"},
      beast = {"jackal", "adder"}
    }
    for _, name in ipairs({"small", "humanoid", "beast"}) do
      local choices = groups[name]
      for _, p in ipairs(dgn.find_marker_positions_by_prop("menu_spawn", name)) do
        dgn.create_monster(p.x, p.y, choices[1 + crawl.random2(#choices)])
      end
    end
  end
}}
MAP
